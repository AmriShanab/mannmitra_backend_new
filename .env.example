APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://mann-mitra.co.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RAZORPAY_API_KEY=
RAZORPAY_API_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public HTTPS origin of the socket server (proxied by Nginx at /socket.io/)
REALTIME_SOCKET_URL=https://mann-mitra.co.in
REALTIME_SECRET=
# Comma-separated; add turns:mann-mitra.co.in:5349 once coturn has a TLS cert
TURN_URLS=turn:mann-mitra.co.in:3478
TURN_SECRET=
TURN_USERNAME=
TURN_PASSWORD=

# Temporary pay-per-exercise pricing (INR / sessions per pack)
EXERCISE_PRICE=75
EXERCISE_SESSIONS=5

# OpenAI tuning (defaults shown)
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
OPENAI_RETRIES=2
OPENAI_MAX_TOKENS=600
EXERCISES_STATE_MACHINE=true

# Exercise wording: false = fixed text only, no OpenAI calls. true = short personalised AI lines
# that react to what the user types (falls back to fixed text if the AI fails).
EXERCISE_AI_ENABLED=false
EXERCISE_AI_TIMEOUT=8
EXERCISE_AI_BREAKER_SECONDS=60
